# Cloud SIEM & GRC Platform - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env.

# ── Application ────────────────────────────────────────────────
ENV=development                 # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/platform.db

# ── API security ───────────────────────────────────────────────
# Required when ENV=production. Clients send it as the X-API-Key header.
API_KEY=
RATE_LIMIT_RPM=100
MAX_BODY_BYTES=2000000
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── AWS ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_GUARDDUTY_DETECTOR_ID=

# ── Azure ──────────────────────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# ── Threat Intelligence ────────────────────────────────────────
VT_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
